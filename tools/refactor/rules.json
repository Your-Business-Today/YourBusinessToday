{
  "sourceGlobs": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "scripts/**/*.ts"
  ],
  "excludeGlobs": [
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/*.d.ts",
    "**/_to_delete/**"
  ],
  "maxFileLines": 100,
  "maxFunctionLines": 30,
  "fileLengthExemptGlobs": [
    "src/app.d.ts",
    "src/lib/data/legal/**"
  ],
  "booleanPrefixes": [
    "is",
    "has",
    "should",
    "can",
    "was",
    "will",
    "must",
    "allows"
  ],
  "bannedAbbreviations": [
    "usr",
    "btn",
    "cfg",
    "tmp",
    "req",
    "res",
    "ctx",
    "idx",
    "err",
    "msg",
    "num",
    "val",
    "cnt",
    "arr",
    "obj2",
    "fn"
  ],
  "commentMarkers": {
    "line": "//",
    "documentation": [
      "/**",
      "*",
      "*/"
    ],
    "markup": "<!--"
  },
  "duplication": {
    "minTokens": 70,
    "ignoreGlobs": [
      "**/node_modules/**",
      "**/.svelte-kit/**",
      "**/migrations/**"
    ]
  },
  "inventory": {
    "pagesGlob": "src/routes/**/+page.svelte",
    "componentsGlob": "src/lib/components/**/*.svelte",
    "widgetMarkers": {
      "table": "<table",
      "modal": "Modal",
      "form": "<form",
      "submit": "SubmitButton",
      "error": "FormErrorNote",
      "list": "{#each",
      "badge": "Badge",
      "pill": "Pill"
    }
  },
  "styleTokens": {
    "markupGlobs": [
      "src/**/*.svelte",
      "src/**/*.css"
    ],
    "forbidInlineHexColours": true,
    "forbidInlineStyleAttributes": true
  },
  "prose": {
    "maxMemberAccessesPerLine": 3,
    "maxLineLength": 160,
    "maxIndentDepth": 5,
    "indentWidth": 4,
    "indentedFileGlobs": [
      "src/**/*.ts",
      "src/**/*.svelte"
    ],
    "maxMemberChainDepth": 1,
    "freeChainPrefixes": [
      "this.",
      "base.",
      "self.",
      "import.meta."
    ]
  },
  "functionNames": {
    "maxWords": 5,
    "maxLength": 40
  },
  "frameworkHandlers": {
    "namePatterns": [
      "^on[A-Z]",
      "^handle[A-Z]",
      "^On[A-Z]",
      "^Handle[A-Z]"
    ],
    "names": [],
    "coincidenceLines": 12
  },
  "areas": [
    {
      "name": "tests",
      "globs": [
        "**/*.test.*",
        "**/*.spec.*",
        "**/tests/**",
        "**/Tests/**",
        "**/*.Tests/**",
        "**/*Tests.cs"
      ]
    },
    {
      "name": "docs",
      "globs": [
        "**/*.md",
        "docs/**"
      ]
    },
    {
      "name": "tooling",
      "globs": [
        "tools/**",
        ".claude/**",
        "scripts/**"
      ]
    },
    {
      "name": "database",
      "globs": [
        "supabase/**",
        "**/migrations/**",
        "**/*.sql"
      ]
    },
    {
      "name": "api",
      "globs": [
        "src/routes/**/+server.*",
        "src/routes/api/**",
        "src/lib/server/mcp/**"
      ]
    },
    {
      "name": "backend",
      "globs": [
        "src/lib/server/**",
        "src/**/*.server.*",
        "src/hooks*"
      ]
    },
    {
      "name": "frontend",
      "globs": [
        "src/**/*.svelte",
        "src/**/*.css",
        "src/lib/components/**",
        "src/app.html",
        "static/**"
      ]
    },
    {
      "name": "shared",
      "globs": [
        "src/lib/**",
        "src/**/*.ts"
      ]
    },
    {
      "name": "infrastructure",
      "globs": [
        ".github/**",
        "*.config.*",
        "*.json",
        "*.yml",
        "*.yaml",
        ".*"
      ]
    }
  ],
  "designPatterns": {
    "entityGlobs": [
      "src/lib/types/**/*.ts",
      "src/lib/entities/**/*.ts",
      "src/lib/domain/**/*.ts"
    ],
    "minimumFamilySize": 4,
    "cooccurrenceThreshold": 0.75,
    "fileCountBand": 3.0,
    "acceptedGaps": [
      "src/lib/server/boardroom/callBoardroomPaper.ts",
      "src/lib/server/boardroom/callBoardroomBrief.ts",
      "src/lib/server/mcp/actions/businessBrainRequest.ts",
      "src/lib/server/mcp/actions/businessBrainRuns.ts",
      "src/lib/server/agent/goodActions.ts",
      "src/lib/server/goals/updateProject.ts",
      "src/lib/server/goals/updateTask.ts",
      "src/lib/server/projects/updateTaskProject.ts",
      "src/lib/server/projects/updateTaskTask.ts",
      "src/lib/server/projects/updateTaskActions.ts",
      "src/lib/server/projects/updateTaskRecord.ts",
      "src/lib/server/mcp/actions/boardroomMeetingRequest.ts",
      "src/routes/+page.server.ts",
      "src/routes/about/+page.server.ts",
      "src/routes/case-study/+page.server.ts",
      "src/routes/company/+page.server.ts",
      "src/routes/offer/+page.server.ts",
      "src/routes/privacy/+page.server.ts",
      "src/routes/promo/+page.server.ts",
      "src/routes/tax-calculator/+page.server.ts",
      "src/routes/terms/+page.server.ts"
    ]
  },
  "siteDefinition": {
    "viewGlobs": [
      "**/*.svelte"
    ],
    "routeGlobs": [
      "**/routes/**/+page.svelte"
    ],
    "ignoredTags": [],
    "catalogue": [
      "DashboardPanel",
      "Modal",
      "Sheet",
      "FormField",
      "TabStrip",
      "PageTitle",
      "EmptyState",
      "RecordsTable",
      "Button",
      "Badge"
    ],
    "handRolled": [
      {
        "element": "table",
        "ownedBy": "RecordsTable"
      },
      {
        "element": "input",
        "ownedBy": "FormField",
        "unlessAttributes": [
          "type=\"checkbox\"",
          "type=\"radio\"",
          "type=\"file\"",
          "type=\"hidden\"",
          "type=\"range\""
        ],
        "unlessUnlabelled": true
      },
      {
        "element": "select",
        "ownedBy": "FormField",
        "unlessUnlabelled": true
      },
      {
        "element": "textarea",
        "ownedBy": "FormField",
        "unlessUnlabelled": true
      },
      {
        "element": "h1",
        "ownedBy": "PageTitle",
        "unlessGlobs": [
          "src/lib/components/about/*",
          "src/lib/components/case-study/*",
          "src/lib/components/demo/*",
          "src/lib/components/home/*",
          "src/lib/components/offer/*",
          "src/lib/components/promo/*",
          "src/lib/components/site/LegalArticle.svelte",
          "src/lib/components/taxCalculator/CalculatorHero.svelte",
          "src/routes/contact/+page.svelte"
        ]
      }
    ],
    "horizontalClasses": [
      "flex",
      "inline-flex"
    ],
    "verticalClasses": [
      "flex-col"
    ],
    "document": "tools/refactor/site-definition.md",
    "containerWidgets": [
      "DashboardPanel",
      "Modal",
      "Sheet"
    ]
  },
  "score": {
    "elements": {}
  },
  "inputValidation": {
    "schemaGlobs": [
      "supabase/migrations/**/*.sql",
      "**/migrations/**/*.sql",
      "**/schema.sql"
    ],
    "entryPointGlobs": [
      "src/routes/**/+server.ts",
      "src/routes/**/+page.server.ts",
      "src/routes/**/+layout.server.ts",
      "src/lib/server/mcp/**/*.ts"
    ],
    "writePatterns": [
      "\\.from\\(\\s*['\\\"`](?P<table>\\w+)['\\\"`]\\s*\\)\\s*\\.(?:insert|update|upsert)\\(",
      "\\.insert\\(\\s*(?P<table>\\w+)\\s*\\)\\s*\\.values\\(",
      "\\.update\\(\\s*(?P<table>\\w+)\\s*\\)\\s*\\.set\\(",
      "\\.(?P<table>\\w+)\\.(?:create|createMany|update|updateMany|upsert)\\(",
      "insert\\s+into\\s+(?:\\w+\\.)?[\\\"`\\[]?(?P<table>\\w+)",
      "\\bupdate\\s+(?:\\w+\\.)?[\\\"`\\[]?(?P<table>\\w+)[\\\"`\\]]?\\s+set\\b"
    ],
    "validatorPatterns": [
      "\\bz\\.(?:object|string|number|enum|coerce)\\b",
      "\\bv\\.(?:object|string|pipe)\\(",
      "\\byup\\.",
      "\\bJoi\\.",
      "superValidate\\(",
      "\\.safeParse\\(",
      "\\bnew Ajv\\b",
      "\\bvalidate[A-Z]\\w*\\("
    ],
    "exemptGlobs": [
      "src/**/*.test.ts",
      "src/lib/server/mcp/resolveMcpCaller.ts",
      "src/lib/server/mcp/actionTypes.ts",
      "src/lib/server/mcp/actions/accountActions.ts",
      "src/lib/server/mcp/actions/batonSentence.ts",
      "src/lib/server/mcp/actions/findMemberOn.ts",
      "src/lib/server/mcp/actions/modelSettingsActions.ts",
      "src/lib/server/mcp/actions/orderingFields.ts",
      "src/lib/server/mcp/actions/queueFields.ts",
      "src/lib/server/mcp/actions/requestedByField.ts",
      "src/lib/server/mcp/actions/serverErrorActions.ts",
      "src/lib/server/mcp/actions/dataInventoryActions.ts",
      "src/lib/server/mcp/actions/storyFields.ts",
      "src/lib/server/mcp/actions/businessBrainSchemas.ts",
      "src/lib/server/mcp/actions/businessBrainChatbotSchemas.ts",
      "src/lib/server/mcp/actions/companyContextFields.ts",
      "src/lib/server/mcp/actions/booksFields.ts",
      "src/lib/server/mcp/actions/booksCustomerFields.ts",
      "src/lib/server/mcp/actions/booksInvoiceFields.ts",
      "src/lib/server/mcp/actions/booksExpenseFields.ts",
      "src/lib/server/mcp/actions/booksPeriodEndFields.ts",
      "src/lib/server/mcp/actions/clientDetailActions.ts",
      "src/lib/server/mcp/actions/describeInbox.ts",
      "src/routes/projects/kit-versions/+page.server.ts"
    ]
  }
}
