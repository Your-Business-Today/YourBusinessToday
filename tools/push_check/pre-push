#!/bin/sh
# Git's pre-push hook, armed by the project-process kit (tools/push_check): a push is refused until the
# repository's own checks have passed on exactly what is being pushed. It refuses only when the push check
# says so (exit 77): a branch without the tool, a machine without python3, or a fault in the tool lets the
# push through. Run `python3 tools/push_check` before pushing, and never push round this with --no-verify
# to save time: the kit's working process, in CLAUDE.md, names the one push that may.
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$root/tools/push_check/__main__.py" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
python3 "$root/tools/push_check" hook "$@"
[ "$?" -eq 77 ] || exit 0
exit 1
