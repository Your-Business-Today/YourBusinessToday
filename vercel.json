{
	"rewrites": [
		{
			"source": "/.well-known/microsoft-identity-association",
			"destination": "/.well-known/microsoft-identity-association.json"
		}
	],
	"crons": [
		{
			"path": "/api/watch/heartbeat",
			"schedule": "0 6 * * *"
		},
		{
			"path": "/api/watch/geocode_register",
			"schedule": "5 6 * * *"
		},
		{
			"path": "/api/watch/food_hygiene",
			"schedule": "10 6 * * *"
		},
		{
			"path": "/api/watch/accounts_filed",
			"schedule": "20 6 * * 2-6"
		},
		{
			"path": "/api/watch/gazette_notices",
			"schedule": "30 6 * * *"
		}
	]
}
